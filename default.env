# Copy to .env and adjust:  cp default.env .env

# Public related config
BASEMAP_PUBLIC_URL=http://localhost:8080
EXPOSE_PORT=8080
API_HOST=api
# Space-separated CIDRs of proxies in front of this whose X-Forwarded-For can be trusted, so rate
# limits key on the real client rather than the edge. Empty = trust nobody. If you put Cloudflare
# in front, list its ranges here or every visitor shares one rate-limit bucket.
TRUSTED_PROXY_CIDR=

# its just docker container url
RENDERER_URL=http://renderer
# Keep this equal to the QGIS Desktop version that saved project.qgz.
QGIS_VERSION=4.2.1

# Must match the `service=` name in project.qgz's layer datasources (currently `mellabasemap`).
PG_SERVICE_NAME=mellabasemap
QGIS_SERVER_LOG_LEVEL=1
FCGID_MAX_PROCESSES=5

# NGINX Tile caching
TILE_CACHE_DIR=/var/cache/tiles
TILE_TTL_DAYS=120
TILE_SWEEP_INTERVAL_HOURS=6
# Sent to browsers and CDNs. Independent of TILE_TTL_DAYS, which governs our own disk.
TILE_CLIENT_MAX_AGE=604800
MIN_ZOOM=0
MAX_ZOOM=20
# Renders a public layer from a *different* QGIS layer depending on zoom, so one URL can serve cheap
# generalized geometry zoomed out and expensive OSM detail zoomed in. Comma-separated
# `<public>@<lo>-<hi>=<upstream>`; first match wins, and anything unmatched renders from its own
# name. The tile is always cached under the *public* name, so nginx's try_files is unaffected.
#
#   countries@0-3=simple-countries    z0-3 from Natural Earth, z4+ from the OSM detail group
#
# Until scripts/build-osm-detail.sh has produced the GeoPackages and the detail layers are added to
# project.qgz, route the whole range to simple-countries instead:
TILE_LAYER_ROUTES=countries@0-20=simple-countries
# Host directory holding the built detail GeoPackages, mounted read-only at /data in the renderer.
OSM_DETAIL_DIR=/mnt/meow/OSM/out
# Set by scripts/sync-project-version.sh to a hash of qgis-server/project/project.qgz. A change
# here makes the API wipe its whole tile cache on next start instead of waiting out TILE_TTL_DAYS.
# Leave empty to skip this and rely on TILE_TTL_DAYS alone.
PROJECT_VERSION=

# Concurrency
RENDER_CONCURRENCY=4
RENDER_QUEUE_TIMEOUT_SECS=20
RENDER_TIMEOUT_SECS=60
# Hot in-memory tier; also the single-flight table that collapses concurrent misses for one tile.
TILE_MEMORY_CAPACITY=4096
TILE_MEMORY_TTL_SECS=600
TILE_NEGATIVE_TTL_SECS=60

# postgresql connection for qgis server
DB_NAME=mellabasemap
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
